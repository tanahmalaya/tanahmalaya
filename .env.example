# Database (Postgres - boleh guna Supabase/Neon/Railway percuma untuk mula)
# DATABASE_URL: guna connection string "Pooler" (port 6543) - untuk aplikasi biasa
DATABASE_URL="postgresql://user:password@localhost:5432/tanahmalaya"
# DIRECT_URL: guna connection string "Direct connection" (port 5432) - untuk npm run db:push sahaja
DIRECT_URL="postgresql://user:password@localhost:5432/tanahmalaya"

# URL laman web (untuk callback BayarCash & metadata)
NEXT_PUBLIC_SITE_URL="https://tanahmalaya.org"

# BayarCash (dapatkan dari console.bayar.cash > Profile > Integration)
BAYARCASH_PAT=""
BAYARCASH_SECRET_KEY=""
# 2 portal berasingan - kalau Tuan cuma nak 1 portal untuk semua, isi
# kedua-dua dengan portal key yang SAMA
BAYARCASH_PORTAL_KEY_KEAHLIAN=""
BAYARCASH_PORTAL_KEY_MERCHANDISE=""
BAYARCASH_PORTAL_KEY_PROGRAM=""
# Set "true" untuk guna sandbox (ujian), kosongkan/padam untuk guna akaun LIVE sebenar
BAYARCASH_SANDBOX=""

# EasyParcel (dapatkan dari app.easyparcel.com > Integration > API Key)
EASYPARCEL_API_KEY=""
EASYPARCEL_SANDBOX=""
# Open API app (Developer Hub > Webhook) - untuk sahkan payload webhook
EASYPARCEL_CLIENT_ID=""
EASYPARCEL_CLIENT_SECRET=""
# Token rawak sendiri, letak sebagai ?token=... dalam URL webhook yang didaftar
# di Developer Hub (EasyParcel tak sokong signature verification secara rasmi)
EASYPARCEL_WEBHOOK_TOKEN=""
# Maklumat PENGHANTAR (alamat PLT untuk pickup kurier)
EASYPARCEL_SENDER_NAME="Pertubuhan Literasi Tanah"
EASYPARCEL_SENDER_PHONE=""
EASYPARCEL_SENDER_ADDRESS=""
EASYPARCEL_SENDER_POSTCODE=""
EASYPARCEL_SENDER_CITY=""
EASYPARCEL_SENDER_STATE=""
# Service ID lalai untuk produk "Kadar Tetap" (dapatkan dari dashboard EasyParcel)
EASYPARCEL_DEFAULT_SERVICE_ID="EP-CS0ME" # SPX Xpress

# Sesi admin dashboard - jana rentetan rawak panjang (32+ aksara)
JWT_SECRET=""
