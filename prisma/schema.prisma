// Skema database Pertubuhan Literasi Tanah (PLT) - tanahmalaya.org
// Guna PostgreSQL (boleh tukar ke MySQL kalau perlu - tukar "provider" di bawah)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- ADMIN ----------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // "ADMIN" (semua akses) atau "STAFF" (Pesanan sahaja)
  createdAt    DateTime @default(now())
}

// Akaun admin berasingan khusus untuk gerantanah.com (GERAN) - entiti
// berasingan dari dashboard admin PLT (AdminUser di atas).
model GeranAdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// ---------- Membership ----------
// Dua jenis keahlian:
// - PLT       = Ahli PLT (ahli penuh, wajib), yuran RM50/tahun, no ahli siri "TM-",
//               kena disahkan admin (bermastautin/berdaftar mengundi Selangor) sebelum AKTIF.
// - BERSEKUTU = Ahli Bersekutu/Fans, yuran RM5, no ahli siri "PLT-", terus AKTIF lepas bayar.
enum MemberType {
  PLT
  BERSEKUTU
}

// Rekod SEMENTARA - simpan borang Membership semasa pelawat tengah bayar.
// Bila bayaran BERJAYA, rekod Member sebenar baru dicipta dan ini dipadam.
model PendingRegistration {
  id            String     @id @default(cuid())
  fullName      String
  icNumber      String
  phone         String
  email         String
  memberType    MemberType @default(BERSEKUTU)
  akuanSelangor Boolean    @default(false) // akujanji bermastautin/berdaftar mengundi Selangor (hanya relevan utk PLT)
  createdAt     DateTime   @default(now())
}

model Member {
  id            String       @id @default(cuid())
  memberNo      String       @unique // cth: TM-001 (Ahli PLT) atau PLT-001 (Ahli Bersekutu)
  noAhliLama    String? // no ahli asal (cth: TM-002) jika ahli lama daftar semula & dapat memberNo baharu
  fullName      String
  icNumber      String       @unique // no kad pengenalan, tanpa tanda "-"
  phone         String
  email         String
  type          MemberType   @default(BERSEKUTU)
  status        MemberStatus @default(AKTIF)
  akuanSelangor Boolean      @default(false) // akujanji ahli PLT bermastautin/berdaftar mengundi Selangor
  joinedAt      DateTime     @default(now())
  paymentRef    String? // rujukan transaksi BayarCash
  addedManually Boolean      @default(false) // true jika admin import ahli sedia ada

  // Refund yuran - untuk ahli yang DITOLAK (status TIDAK_AKTIF) selepas bayar.
  // Ahli isi borang refund di /keahlian/semak, admin proses transfer manual
  // (bukan automatik BayarCash) lepas tu tandakan refundedAt.
  refundRequested     Boolean   @default(false)
  refundBankName      String?
  refundAccountNo     String?
  refundAccountHolder String?
  refundRequestedAt   DateTime?
  refundedAt          DateTime?

  // Maklumat bank disimpan lepas tuntutan petty cash PERTAMA (lihat
  // PettyCashClaim) supaya ahli tak perlu isi semula setiap kali mohon.
  savedBankName      String?
  savedAccountNo     String?
  savedAccountHolder String?

  // OTP e-mel untuk log masuk kawasan Ahli PLT (2 langkah: Nama + No. KP,
  // kemudian kod 6-digit dihantar ke e-mel berdaftar) - lihat lib/memberAuth.ts
  // dan app/api/members/login-request & login-verify. Kod disimpan sebagai
  // hash (bukan plain text), dikosongkan lepas berjaya log masuk/tamat tempoh.
  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  otpSentAt    DateTime? // untuk hadkan kekerapan minta kod baharu (anti-spam)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hargaTanahSubmissions HargaTanahSubmission[]
  pettyCashClaims       PettyCashClaim[]
}

enum MemberStatus {
  AKTIF
  TIDAK_AKTIF
  MENUNGGU_BAYARAN
  MENUNGGU_SEMAKAN // Ahli PLT dah bayar, tunggu admin sahkan mastautin/pengundi Selangor
}

// ---------- Program & Kelas ----------
model LandClass {
  id            String              @id @default(cuid())
  tarikh        DateTime
  namaKelas     String // cth: "Kelas Asas 1"
  topik         String
  jenisKelas    ProgramType         @default(OFFLINE)
  lokasi        String // cth: "Zoom Online" / "PLT Centre (Kuala Lumpur)"
  jadual        String? // cth: "Setiap Isnin & Khamis, 8:00pm-9:00pm"
  maxPeserta    Int? // had bilangan peserta/seat, kosong = tiada had
  yuranSen      Int                 @default(0) // yuran kelas dalam sen, 0 = percuma
  picName       String? // nama person in charge
  picContact    String? // no telefon/emel PIC
  status        ClassStatus         @default(TERBUKA)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  registrations ClassRegistration[]
}

enum ProgramType {
  ONLINE
  OFFLINE
  HYBRID
}

enum ClassStatus {
  TERBUKA
  PENUH
  TAMAT
}

// Pendaftaran peserta untuk satu program/kelas
model ClassRegistration {
  id           String             @id @default(cuid())
  classId      String
  namaPeserta  String
  telefon      String
  emel         String
  status       RegistrationStatus @default(MENUNGGU)
  bayarcashRef String?
  createdAt    DateTime           @default(now())
  class        LandClass          @relation(fields: [classId], references: [id])
}

enum RegistrationStatus {
  MENUNGGU
  BERJAYA
  GAGAL
}

// ---------- Aktiviti ----------
model Activity {
  id         String   @id @default(cuid())
  tarikh     DateTime
  tajuk      String
  keterangan String
  gambar1    String?
  gambar2    String?
  gambar3    String?
  gambar4    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------- Merchandise ----------
model Setting {
  key   String @id
  value String
}

model Product {
  id              String        @id @default(cuid())
  nama            String
  kodRingkas      String? // singkatan pendek (cth "TSS", "HM", "JCK") untuk remark/AWB label - elak teks bertindih bila banyak barang dalam satu order
  penerangan      String?
  hargaSen        Int // simpan dalam sen supaya elak isu titik perpuluhan
  gambarDepan     String? // gambar Utama - dipaparkan dalam senarai produk
  gambarBelakang  String?
  gambarSisi      String?
  sizingChartUrl  String? // carta saiz (untuk baju, dll)
  stok            Int           @default(0) // stok keseluruhan - diguna HANYA jika produk tiada saiz (lihat ProductSize)
  status          ProductStatus @default(READY_STOCK)
  aktif           Boolean       @default(true)
  // Penghantaran: FLAT = kadar tetap, BERAT = kira automatik ikut berat & poskod
  shippingMode    ShippingMode  @default(FLAT)
  shippingFlatSen Int? // kadar tetap dalam sen (guna jika shippingMode = FLAT)
  beratGram       Int? // berat produk dalam gram (guna jika shippingMode = BERAT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orderItems      OrderItem[]
  sizes           ProductSize[] // kosong = produk tiada pilihan saiz (guna field "stok" di atas)
}

enum ProductStatus {
  READY_STOCK
  PREORDER
}

enum ShippingMode {
  FLAT
  BERAT
}

// Stok per-saiz untuk produk berbentuk pakaian (baju, dll). Bila produk ada
// sekurang-kurangnya satu baris di sini, pelanggan WAJIB pilih saiz semasa
// checkout dan stok ditrack berasingan ikut saiz (bukan Product.stok).
model ProductSize {
  id         String      @id @default(cuid())
  productId  String
  saiz       Saiz
  stok       Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, saiz])
}

enum Saiz {
  S
  M
  L
  XL
  XXL // dipaparkan sebagai "2XL"
  XXXL // dipaparkan sebagai "3XL"
}

model Order {
  id                String      @id @default(cuid())
  seq               Int         @default(autoincrement()) // nombor mudah #1, #2 untuk staff
  memberId          String?
  namaPembeli       String
  emel              String
  telefon           String
  // Alamat penghantaran
  alamat            String      @default("")
  poskod            String      @default("")
  bandar            String      @default("")
  negeri            String      @default("")
  jumlahSen         Int
  shippingSen       Int         @default(0)
  // Tiada kadar SPX/J&T automatik untuk destinasi ni masa checkout - shippingSen
  // guna caj flat sementara, staff kena pilih kurier sebenar & sahkan caj manual.
  manualCourier     Boolean     @default(false)
  status            OrderStatus @default(MENUNGGU)
  bayarcashRef      String?
  // EasyParcel
  courierName       String?
  serviceId         String?
  easyparcelOrderNo String?
  trackingNumber    String?
  awbUrl            String? // pautan PDF label AWB sebenar dari EasyParcel (untuk cetak)
  fulfillmentError  String? // diisi kalau cubaan proses order gagal
  printedAt         DateTime? // masa staff klik "Mark as Shipped"
  // Status terkini dari webhook EasyParcel (topic "tracking/create"), cth: "Delivery In Transit"
  courierStatus     String?
  courierStatusAt   DateTime?
  // Refund
  refundSen         Int? // jumlah refund dalam sen (boleh partial, <= jumlahSen)
  refundReason      String?
  refundedAt        DateTime?
  createdAt         DateTime    @default(now())
  items             OrderItem[]
}

enum OrderStatus {
  MENUNGGU // menunggu bayaran
  BERJAYA // bayaran berjaya, tunggu fulfill/pos
  GAGAL // bayaran gagal
  SELESAI // dah dicetak & dipos (auto bila staff klik "Selesai Cetak")
  DIPULANGKAN // refund
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  productId     String
  productSizeId String? // rujukan baris ProductSize (jika produk ada saiz)
  saiz          Saiz? // saiz yang dibeli, disimpan terus supaya kekal dalam rekod order walaupun ProductSize dipadam kemudian
  kuantiti      Int
  hargaSen      Int
  order         Order        @relation(fields: [orderId], references: [id])
  product       Product      @relation(fields: [productId], references: [id])
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
}

// ---------- ADUAN PENCEROBOHAN TANAH ----------
enum HubunganTanah {
  PEMILIK_BERDAFTAR
  JIRAN_PENDUDUK
  WAKAF_AMANAH
  WAKIL_KOMUNITI_NGO
  ORANG_AWAM
}

enum StatusKategoriTanah {
  KERAJAAN_RIZAB
  PERSENDIRIAN
  ADAT_RIZAB_MELAYU
  TIDAK_PASTI
}

enum StatusAduan {
  BAHARU
  DALAM_SEMAKAN
  SELESAI
}

// Borang aduan awam pencerobohan/penyalahgunaan tanah (/hubungi-kami).
// Pengadu boleh pilih kekal anonim - dalam kes ni namaPenuh/telefon/emel kosong.
model LandComplaint {
  id  String @id @default(cuid())
  seq Int    @default(autoincrement()) // no ringkas utk rujukan staff, cth #12

  // Bahagian 1: Maklumat Pengadu
  anonim            Boolean       @default(true)
  benarkanDihubungi Boolean       @default(false)
  namaPenuh         String?
  telefon           String?
  emel              String?
  hubungan          HubunganTanah

  // Bahagian 2: Lokasi & Identiti Tanah
  negeri              String
  daerahMukim         String
  nomborLot           String?
  gpsLat              Float?
  gpsLng              Float?
  statusKategoriTanah StatusKategoriTanah

  // Bahagian 3: Butiran Isu & Pencerobohan
  jenisPencerobohan    String[] // cth: ["STRUKTUR_HARAM", "PERTANIAN", ...]
  jenisLain            String? // penjelasan bila pilih "Lain-lain"
  anggaranTarikhMula   DateTime?
  keteranganTerperinci String    @db.Text

  // Bahagian 4: Bukti Fizikal & Lampiran (URL fail di Vercel Blob)
  fotoUrls    String[] // maksimum 5
  dokumenUrls String[]

  // Bahagian 5: Pengesahan & Penafian
  pengesahanMaklumat Boolean
  persetujuanPdpa    Boolean

  status    StatusAduan @default(BAHARU)
  notaAdmin String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// ---------- SUMBANGAN IKHLAS ----------
enum DonationStatus {
  MENUNGGU
  BERJAYA
  GAGAL
}

// Sumbangan bebas daripada orang awam (bukan yuran keahlian) - dipautkan
// dari hujung Borang Aduan Pencerobohan Tanah & /sumbangan.
model Donation {
  id           String         @id @default(cuid())
  seq          Int            @default(autoincrement())
  namaPenderma String
  emel         String
  telefon      String
  amountSen    Int
  status       DonationStatus @default(MENUNGGU)
  bayarcashRef String?
  createdAt    DateTime       @default(now())
}

// ---------- PETA ANGGARAN HARGA TANAH ----------
enum JenisTanah {
  KOSONG // tanah kosong / vacant land
  PERTANIAN // ladang getah/sawit/durian/hortikultur/estet dll
  PEMBANGUNAN // development land
  PERUMAHAN
  PERINDUSTRIAN
  KOMERSIAL
}

enum JenisHakmilik {
  FREEHOLD
  LEASEHOLD
  TIDAK_PASTI
}

// Siapa yang SAH boleh memiliki lot ini - paksi berasingan daripada jenisTanah
// (guna tanah) dan jenisHakmilik (freehold/leasehold). Ini soalan pertama yang
// pembeli tanah Malaysia tanya, kerana ia menentukan sama ada dia layak membeli
// langsung, bukan sekadar mempengaruhi harga.
//
// RIZAB_MELAYU  tanah diwartakan di bawah Enakmen Tanah Simpanan Melayu
// LOT_BUMI      lot di bawah kuota Bumiputera, perlu kebenaran negeri untuk lepas
// LOT_NON_BUMI  tiada sekatan kaum pada pemindahan hakmilik
// TIDAK_PASTI   lalai - penjual selalunya tak tahu; admin betulkan semasa
//               semakan selepas membaca salinan geran
enum StatusPemilikan {
  RIZAB_MELAYU
  LOT_BUMI
  LOT_NON_BUMI
  TIDAK_PASTI
}

enum UnitKeluasan {
  SQFT
  EKAR
  HEKTAR
}

// Data rujukan RASMI - diimport dari "Jadual Data Transaksi Harta Tanah" NAPIC
// (napic.jpph.gov.my/ms/penerbitan > Pasaran Harta Tanah), diterbitkan sukuan,
// peringkat DAERAH sahaja (bukan mukim/lot). Satu row = satu kombinasi
// (negeri, daerah, tahun, sukuan, jenisTanah, julatHarga).
model NapicRujukanHarga {
  id            String     @id @default(cuid())
  negeri        String
  daerah        String
  tahun         Int
  sukuan        String // label asal NAPIC, cth "Q1" / "S1"
  jenisTanah    JenisTanah
  julatHargaMin Int // RM, cth 100000
  julatHargaMax Int? // RM, null = julat terbuka ("1,000,001 & Above")
  bilangan      Int        @default(0) // bilangan transaksi dalam julat ni
  nilaiSen      BigInt? // jumlah nilai transaksi (sen) dalam julat ni, jika tersedia dalam fail
  sumberFail    String? // nama fail asal NAPIC, untuk rujukan/audit
  createdAt     DateTime   @default(now())

  @@unique([negeri, daerah, tahun, sukuan, jenisTanah, julatHargaMin])
  @@index([negeri, daerah])
}

enum JenisHargaSubmission {
  TAWARAN // harga tawaran/asking price
  TRANSAKSI // harga jual-beli sebenar
}

enum StatusSemakanHarga {
  MENUNGGU_SEMAKAN
  DISAHKAN
  DITOLAK
}

// Harga tanah submit oleh ahli (crowd-sourced) - untuk anggaran per-lot yang
// lebih tepat berbanding purata daerah NAPIC. Perlu disahkan admin dulu
// sebelum dipaparkan awam (alur sama macam Member.MENUNGGU_SEMAKAN).
model HargaTanahSubmission {
  id       String  @id @default(cuid())
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])

  gpsLat      Float
  gpsLng      Float
  negeri      String
  daerahMukim String
  nomborLot   String?

  jenisTanah    JenisTanah
  jenisHakmilik JenisHakmilik        @default(TIDAK_PASTI)
  keluasan      Float
  unitKeluasan  UnitKeluasan         @default(SQFT)
  hargaSen      BigInt // harga tawaran/transaksi, dalam sen
  jenisHarga    JenisHargaSubmission @default(TAWARAN)
  tarikh        DateTime             @default(now())

  status    StatusSemakanHarga @default(MENUNGGU_SEMAKAN)
  notaAdmin String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([negeri, daerahMukim])
}

// ---------- IKLAN KOMUNITI (auto-rotate) ----------
model Ad {
  id        String   @id @default(cuid())
  namaAhli  String // cth: "Roofman", "JomNikah", "Barang Thai"
  gambarUrl String
  pautan    String // link keluar bila diklik
  aktif     Boolean  @default(true)
  susunan   Int      @default(0) // urutan paparan
  createdAt DateTime @default(now())
}

// ---------- TUNTUTAN PETTY CASH (kawasan ahli PLT sahaja - lihat lib/memberAuth.ts) ----------
model PettyCashClaim {
  id  String @id @default(cuid())
  seq Int    @default(autoincrement())

  memberId    String
  member      Member @relation(fields: [memberId], references: [id])
  // Snapshot nama/no ahli masa mohon (kekal konsisten dalam rekod claim
  // walaupun profil ahli berubah selepas ni).
  namaPemohon String
  memberNo    String

  jumlahSen          Int // jumlah tuntutan, dalam sen
  kategori           ClaimKategori
  tujuan             String
  tarikhPerbelanjaan DateTime
  resitUrl           String? // pilihan - tak wajib untuk perbelanjaan berkaitan kerja

  bankName      String
  accountNo     String
  accountHolder String

  status       ClaimStatus @default(MENUNGGU)
  catatanAdmin String? // sebab tolak / nota admin lain

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ClaimKategori {
  PENGANGKUTAN
  ALAT_TULIS
  PROGRAM_AKTIVITI
  LAIN_LAIN
}

enum ClaimStatus {
  MENUNGGU
  DILULUSKAN
  DITOLAK
  DIBAYAR
}

// ---------- MARKETPLACE GERAN TANAH (terbuka kepada awam) ----------
// Akaun ringkas untuk sesiapa sahaja (bukan semestinya Ahli PLT) senaraikan
// tanah bergeran untuk dijual - log masuk OTP e-mel, alur sama macam
// Member.otpCodeHash di atas tapi tanpa yuran/kelulusan keahlian.
model Seller {
  id       String @id @default(cuid())
  fullName String
  phone    String
  email    String @unique

  // null = akaun lama dari zaman log masuk OTP sahaja. Pengguna macam ni
  // kena lalui aliran "set kata laluan" (app/api/sellers/lupa-kata-laluan)
  // sekali sebelum boleh log masuk semula.
  passwordHash String?

  // Bila pengguna tanda setuju notis privasi semasa daftar - lihat
  // app/geran/privasi. null untuk akaun yang wujud sebelum notis itu ada.
  persetujuanPdpaPada DateTime?

  // Had cubaan log masuk supaya kata laluan tak boleh dicuba secara pukal.
  cubaanLogMasuk  Int       @default(0)
  dikunciSehingga DateTime?

  // Kod sekali guna untuk set/reset kata laluan. Pendaftaran baharu TIDAK
  // guna medan ni - ia duduk dalam PendaftaranTertunda sehingga emel disahkan.
  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  otpSentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gerans    Geran[]
  favorites GeranFavorite[]
}

// Pendaftaran yang belum sah emel. Sengaja BUKAN dalam jadual Seller: dulu
// borang daftar terus tulis nama/telefon/emel ke Seller sebelum kod
// disahkan, jadi sesiapa yang tutup tab di tengah jalan - atau taip emel
// orang lain - tinggalkan rekod kekal. Baris di sini luput sendiri dan
// dibersihkan pada permintaan daftar berikutnya.
model PendaftaranTertunda {
  id       String @id @default(cuid())
  fullName String
  phone    String
  email    String @unique

  passwordHash        String
  persetujuanPdpaPada DateTime

  kodHash         String
  kodLuputPada    DateTime
  cubaan          Int      @default(0)
  kodDihantarPada DateTime

  createdAt DateTime @default(now())

  @@index([kodLuputPada])
}

enum StatusGeran {
  MENUNGGU_SEMAKAN // baru dihantar penjual, admin belum semak
  DALAM_RUNDINGAN // admin sedang runding harga dengan penjual
  DISAHKAN // harga dipersetujui & tersiar di direktori awam
  DITOLAK
}

// Sumber penyenaraian tanah di gerantanah.com.
enum SumberGeran {
  PLT // stok tanah PLT sendiri
  KJ_LAND // dari KJ Land consultant
  PENGGUNA // dihantar pengguna laman web melalui /geran/jual
}

// Tanah bergeran (hakmilik jelas) disenaraikan sendiri oleh penjual untuk
// dipaparkan dalam direktori carian awam /geran - disemak & disahkan admin
// dulu sebelum kelihatan awam, alur sama macam HargaTanahSubmission di atas.
model Geran {
  id  String @id @default(cuid())
  seq Int    @default(autoincrement())

  // Dari mana penyenaraian ni datang - PLT & KJ_LAND dimasukkan sendiri oleh
  // admin di /geran/admin/tambah (tiada akaun Seller), PENGGUNA pula dihantar
  // penjual melalui /geran/jual.
  sumber SumberGeran @default(PENGGUNA)

  // null untuk penyenaraian PLT/KJ Land yang dimasukkan admin.
  sellerId       String?
  seller         Seller? @relation(fields: [sellerId], references: [id])
  // Maklumat hubungan yang dipapar pada rekod admin. Untuk PENGGUNA ia
  // snapshot profil penjual masa disenaraikan (kekal konsisten walaupun profil
  // berubah selepas ni); untuk PLT/KJ Land ia hubungan pejabat/perunding.
  namaPenjual    String
  telefonPenjual String
  emelPenjual    String

  tajuk         String // cth: "3 Ekar Tanah Pertanian, Jeram Pasu"
  negeri        String
  daerahMukim   String
  nomborLot     String?
  nomborGeran   String?
  jenisTanah    JenisTanah
  jenisHakmilik JenisHakmilik @default(TIDAK_PASTI)
  statusPemilikan StatusPemilikan @default(TIDAK_PASTI)
  keluasan      Float
  unitKeluasan  UnitKeluasan  @default(SQFT)
  keterangan    String?       @db.Text

  // ---- Harga (semua dalam sen) ----
  // Alur: penjual minta hargaDiminta -> admin semak hargaPasaran -> runding
  // sampai hargaAmbil -> siarkan pada hargaSiaran. Margin PLT/KJ Land ialah
  // hargaSiaran - hargaAmbil.
  //
  // HANYA hargaSiaranSen boleh sampai ke halaman awam. Tiga yang lain adalah
  // maklumat perniagaan dalaman - jangan masukkan dalam GeranListing atau
  // apa-apa prop yang dihantar ke komponen direktori awam.
  hargaDimintaSen BigInt? // apa penjual minta (null untuk stok PLT/KJ Land)
  hargaPasaranSen BigInt? // anggaran harga pasaran oleh PLT
  hargaAmbilSen   BigInt? // harga yang PLT/KJ Land setuju ambil dari penjual
  hargaSiaranSen  BigInt? // harga di direktori awam - WAJIB sebelum DISAHKAN

  // Nota rundingan harga dengan penjual - dalaman, admin sahaja.
  catatanRundingan String? @db.Text

  // Media dirakam oleh PLT/KJ Land sendiri, bukan penjual - ditambah melalui
  // skrin edit admin selepas penyenaraian dihantar.
  gambarUrls      String[] // maksimum 8, URL fail di Vercel Blob (awam)
  videoYoutubeUrl String? // video drone di YouTube (unlisted), dibenamkan di halaman butiran

  // Polygon sempadan tanah yang admin lukis atas media di skrin edit. Disimpan
  // sebagai KOORDINAT ternormal (0..1), bukan dibakar ke dalam fail - jadi ia
  // boleh diedit semula, kekal tajam pada semua saiz skrin, dan tak perlukan
  // storan/bandwidth tambahan. Bentuk data & pengesahan ada di
  // lib/geran-polygon.ts.
  //
  // gambarPolygons: { "<url gambar>": { points: [[x,y], ...] } }
  gambarPolygons Json?
  // videoPolygonTrack: keyframe bertanda masa, dilukis atas embed YouTube dan
  // disegerakkan melalui YouTube IFrame API. Dijejak dalam pelayar dari fail
  // video TEMPATAN admin (optical flow) - fail itu sendiri tak pernah
  // dimuat naik ke mana-mana, cuma ke YouTube secara manual seperti biasa.
  videoPolygonTrack Json?

  // Salinan penuh geran (PDF) untuk semakan admin - tunjuk kaveat, gadaian &
  // sekatan kepentingan. WAJIB untuk penyenaraian PENGGUNA (lihat
  // app/api/geran POST), pilihan untuk PLT/KJ Land yang admin masuk sendiri.
  // URL ni tunjuk ke blob PERIBADI dan tak boleh dibuka terus - admin baca
  // melalui app/api/geran-admin/salinan-geran/[id]. Jangan hantar nilai ni ke
  // pelayar: dokumen itu ada nama, no. KP & alamat tuan tanah.
  salinanGeranUrl String?

  status       StatusGeran @default(MENUNGGU_SEMAKAN)
  catatanAdmin String? // sebab tolak / nota admin lain

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favoritedBy GeranFavorite[]

  @@index([negeri, daerahMukim])
  @@index([status])
}

// Favorite (wishlist) - penjual/pembeli log masuk boleh simpan penyenaraian
// untuk rujuk balik kemudian, lihat /geran/favorite.
model GeranFavorite {
  id       String @id @default(cuid())
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id])
  geranId  String
  geran    Geran  @relation(fields: [geranId], references: [id])

  createdAt DateTime @default(now())

  @@unique([sellerId, geranId])
}

// ---------- ANALITIK DASHBOARD ADMIN ----------
enum LoginActorType {
  MEMBER // Ahli PLT/Bersekutu log masuk kawasan Keahlian
  SELLER // Penjual log masuk kawasan GERAN
}

// Satu baris setiap kali log masuk berjaya - untuk graph "Log Masuk" di
// Ringkasan Dashboard admin. Direkod mula dari bila ciri ni ditambah, jadi
// graph hanya ada data dari tarikh tu ke depan.
model LoginEvent {
  id        String         @id @default(cuid())
  actorType LoginActorType
  actorId   String
  createdAt DateTime       @default(now())

  @@index([actorType, createdAt])
}
